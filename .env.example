# ==========================================
# TetaLogics Survey Respondent Frontend
# ==========================================

# The base URL pointing to the logic backend (logika-be) API to submit answers and fetch questionnaires.
# Dev: http://localhost:8080/api/v1 | Prod: https://api.statistik.id/api/v1
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# PUBLIC_SITE_URL: this survey app's own public base URL — used to build absolute
# OG/Twitter share-image URLs (og:image). Dev: http://localhost:5174 | Prod: https://survey.statistik.id
PUBLIC_SITE_URL=http://localhost:5174

# ── PUBLIC_SSR_API_BASE_URL (OPSIONAL) ────────────────────────────────────────
# Boleh dibiarkan kosong. Kalau tidak diset, SSR memakai PUBLIC_API_BASE_URL —
# URL yang sudah pasti benar, karena peramban juga memakainya.
#
# Gunanya hanya penghematan: kalau survey-fe dan logika-be berada di jaringan
# yang sama, alamat internal memangkas satu perjalanan keluar-masuk Cloudflare
# per render.
#   Docker/Compose: http://logika-be:8080/api/v1
#
# ⚠️ Kalau diisi, pastikan alamatnya BENAR-BENAR terjangkau dari proses SSR.
# Alamat yang salah membuat pengambilan sisi server gagal, dan cat pertama
# memancarkan ikon bawaan platform sebelum branding pelanggan menyusul —
# persis kedip yang justru ingin dihindari. Ragu? Kosongkan saja.
# PUBLIC_SSR_API_BASE_URL=

# ── APP_ENV ──────────────────────────────────────────────────────────────────
# After the May 2026 fix, this variable is NOT used in survey-fe code anymore.
# robots.txt always outputs "Disallow:" (empty). Noindex protection is hardcoded:
#   - <meta name="robots" content="noindex, nofollow"> in every +page.svelte
#   - X-Robots-Tag header in hooks.server.ts (always)
#
# Survey forms are ALWAYS private — safe to set "production" on prod server.
#
# Local dev:  development
# Staging:    development
# Production: production
APP_ENV=development

# ── PUBLIC_USE_MOCK ───────────────────────────────────────────────────────────
# Master switch for the built-in demo survey (src/lib/mockSurvey.ts). Read at
# runtime, so the same build behaves differently per deployment.
#   "1" / "true" → every survey is served from the local fixture; no logika-be
#                  needed. Use for local dev and the dev/staging deploy.
#   unset / "0"  → mock fully disabled; all requests hit the real backend.
#                  REQUIRED for production.
#
# Local dev:  1
# Staging:    1
# Production: 0  (or leave unset)
PUBLIC_USE_MOCK=0

# ── DASHBOARD_ORIGIN ─────────────────────────────────────────────────────────
# Asal (skema + host) dashboard yang boleh membingkai `/pratinjau` lewat
# `Content-Security-Policy: frame-ancestors`. HANYA jalur pratinjau; halaman
# responden tetap tidak bisa dibingkai siapa pun.
#
# Kenapa headernya perlu sama sekali: `X-Frame-Options: DENY` dipasang di TEPI
# (Cloudflare/Traefik) untuk seluruh *.statistika.id dan tidak dikendalikan dari
# repo ini. `frame-ancestors` mengalahkannya, jadi pratinjau bisa hidup tanpa
# melonggarkan apa pun di tepi.
#
# Boleh dikosongkan: bawaannya asal dashboard PRODUKSI, supaya variabel yang
# lupa diset tidak mematikan pratinjau diam-diam. Set hanya untuk dev/staging.
#   Lokal: http://localhost:5173 | Prod: (kosongkan)
DASHBOARD_ORIGIN=http://localhost:5173
