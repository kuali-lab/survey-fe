# ==========================================
# TetaLogics Survey Respondent Frontend
# ==========================================

# The base URL pointing to the logic backend (logika-be) API to submit answers and fetch questionnaires.
# Dev: http://localhost:8080/api/v1 | Prod: https://api.logika-teta.web.id/api/v1
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Environment — controls robots.txt blocking
# survey-fe is always private; keep this as 'development' in all Coolify deployments
APP_ENV=development
